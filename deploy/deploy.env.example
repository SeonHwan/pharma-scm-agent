# 이 파일을 deploy/deploy.env 로 복사해서 값을 채운다. deploy.env는 .gitignore 대상이라 커밋되지 않는다.
# 비밀번호와 키는 영문·숫자만 쓴다(접속 문자열에 그대로 들어간다). 예: openssl rand -hex 16
DB_ADMIN_PASSWORD=
DB_RO_PASSWORD=
DB_EXT_PASSWORD=
# 서버 API 키(클라이언트가 X-API-Key로 보낸다). 이번 배포 전용으로 새로 만든다: openssl rand -hex 24
PHARMA_API_KEY=
# 이번 배포 전용 Anthropic 키(콘솔에서 새로 만들고 끝나면 삭제). 평소 쓰는 키를 쓰지 않는다.
ANTHROPIC_API_KEY=
# 호스트에 여는 포트(기본 8000)
API_PORT=8000
